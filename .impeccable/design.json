  "narrative": {
    "northStar": "The Quiet Workbench",
    "overview": "A warm charcoal room where the model and the spec are the only things that speak. The chrome is low-contrast, flat and thin: one hairline between panes, one cream button per view, colour reserved for build status. Density is moderate rather than IDE-tight; controls are 32-36px tall with roomy 44px form rows, so a beginner can read the form while a maintainer still finds every check.\n\nThe world is Warp-inspired: warm near-black surfaces stepped by a few lightness points instead of shadows, Inter for every interface word, DM Mono only for text the machine reads or writes (spec Markdown, file paths, numbers, frame counters). Real BlenderForge renders are the imagery; nothing decorative competes with them.\n\nThe system refuses the dense five-panel IDE. Two working panes at most, the model stage always the larger one.",
    "keyCharacteristics": [
      "Warm charcoal tonal layering, no shadows, 1px hairlines separate panes.",
      "Cream (`ink`) is both the brightest text and the single primary action.",
      "Status colours (pass, warn, fail) appear only as status, plus warn as the spec-key syntax colour.",
      "Small radii (3px controls, 4px panels and tracks); no pills except 8px status dots.",
      "Segmented controls for every exclusive choice; chips for lists of parts."
    ],
    "rules": [
      {
        "name": "The Status-Only Colour Rule",
        "body": "Hue appears only to report a check result (and amber for spec keys). Any other coloured fill is a defect; user data swatches (skin colour) are content, not chrome.",
        "section": "colors"
      },
      {
        "name": "The One Cream Rule",
        "body": "A view has one cream button: the primary action (Build, New project, Create). Selected clips may be cream because they are state, not action.",
        "section": "colors"
      },
      {
        "name": "The Machine Text Rule",
        "body": "DM Mono is for spec text, paths, hex values, numbers the build reports, and frame counts. Never for headings, buttons or prose.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Labels and group heads are sentence case in `mute`; hierarchy comes from size, weight and colour, not uppercase tracking.",
        "section": "typography"
      },
      {
        "name": "The Model Gets the Room Rule",
        "body": "The model stage is always the largest region; side panes cap at 440px (520px for the template aside).",
        "section": "layout"
      },
      {
        "name": "The Hairline Rule",
        "body": "No box-shadows anywhere. If two regions need separation, use a 1px hairline or a lightness step.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the model stage the largest region and side panes at or under 440px.",
      "**Do** use one cream primary button per view and ghost or line buttons for everything else.",
      "**Do** separate panes with a 1px `hairline` (#3f3a36) and step surfaces by lightness for depth.",
      "**Do** use segmented controls for exclusive choices and chips for part lists.",
      "**Do** set spec text, paths, hex values and build numbers in DM Mono; everything else in Inter.",
      "**Do** show real BlenderForge renders for templates, thumbnails and the stage."
    ],
    "donts": [
      "**Don't** add box-shadows or glows; this world is flat.",
      "**Don't** use status colours (#a8c69f, #e0b36a, #e88a72) for decoration, branding or non-status emphasis.",
      "**Don't** round controls past 4px or make pill buttons; circles are for 8px status dots only.",
      "**Don't** introduce a third working pane or a dense multi-panel IDE layout.",
      "**Don't** use uppercase tracked labels or eyebrows above headings; labels are sentence case."
    ]
  }
}
